#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/bootstrap-mac-remote [options]

Run on anix after the anix bootstrap. Prepares a fresh Mac over SSH, adds its
host key as a sops recipient, and starts the first darwin-rebuild in the Mac's
logged-in Terminal. Apple silicon and Intel are both detected. The macOS TCC
prompts are approved on the Mac.

Options:
  --mac-host HOST   Tailscale/MagicDNS name. Default amac.
  --mac-user USER   Mac login. Default from users.nix.
  --anix-user USER  anix login. Default from users.nix.
  -y, --yes         Accept prompts; never removes anything.
  --dry-run         Print actions without changing either host.
  --no-first-switch Stop after the Mac host key is a recipient.
  -h, --help        Show this help.
EOF
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'warning: %s\n' "$*" >&2; }
say() { printf '\n==> %s\n' "$*"; }
assume_yes=0
dry_run=0
do_switch=1
mac_host=amac
mac_user=
anix_user=
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --mac-host) [[ $# -ge 2 ]] || die "--mac-host needs a value"; mac_host=$2; shift 2 ;;
    --mac-host=*) mac_host=${1#*=}; shift ;;
    --mac-user) [[ $# -ge 2 ]] || die "--mac-user needs a value"; mac_user=$2; shift 2 ;;
    --mac-user=*) mac_user=${1#*=}; shift ;;
    --anix-user) [[ $# -ge 2 ]] || die "--anix-user needs a value"; anix_user=$2; shift 2 ;;
    --anix-user=*) anix_user=${1#*=}; shift ;;
    -y|--yes) assume_yes=1; shift ;;
    --dry-run) dry_run=1; shift ;;
    --no-first-switch) do_switch=0; shift ;;
    *) die "unknown argument: $1" ;;
  esac
done

ask() {
  local prompt=$1 default=${2:-n} reply
  if [[ $assume_yes -eq 1 ]]; then [[ $default == y ]]; return; fi
  if [[ $default == y ]]; then prompt="$prompt [Y/n]"; else prompt="$prompt [y/N]"; fi
  # On EOF, treat the answer as "no" rather than silently taking the default,
  # so a non-interactive run cannot loop forever.
  read -r -p "$prompt " reply || return 1
  reply=${reply:-$default}
  [[ $reply == [Yy]* ]]
}

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(git -C "$script_dir/.." rev-parse --show-toplevel 2>/dev/null || true)
[[ -n $repo_root ]] || die "not a git checkout"
cd "$repo_root"
[[ -s $HOME/.config/sops/age/keys.txt ]] || die "missing personal age key"
[[ -s secrets/secrets.yaml ]] || die "missing secrets/secrets.yaml"

# shellcheck source=anix-config.sh
# shellcheck disable=SC1091
. "$script_dir/anix-config.sh"

value_from_users() {
  anix_value_from_users "$1" "$repo_root/users.nix"
}
[[ -n $mac_user ]] || mac_user=$(value_from_users amac)
[[ -n $anix_user ]] || anix_user=$(value_from_users anix)
[[ -n $mac_user && -n $anix_user ]] || die "could not read users.nix"
for n in "$mac_host" "$mac_user" "$anix_user"; do
  [[ $n =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid name or host: $n"
done

sops_cmd() { nix --extra-experimental-features 'nix-command flakes' shell --inputs-from "$repo_root" nixpkgs#sops -c sops "$@"; }
ssh_to_age_cmd() { nix --extra-experimental-features 'nix-command flakes' shell --inputs-from "$repo_root" nixpkgs#ssh-to-age -c ssh-to-age; }
control="/tmp/anix-mac-${mac_user}@${mac_host}.sock"
# The comma is part of the ssh PreferredAuthentications value.
# shellcheck disable=SC2054
SSH=(ssh -o BatchMode=no -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new -o ControlMaster=auto -o "ControlPath=$control" -o ControlPersist=900 -o PreferredAuthentications=password,keyboard-interactive,publickey -i "$HOME/.ssh/mac-builder" "$mac_user@$mac_host")

if [[ $dry_run -eq 1 ]]; then
  say "Dry run: Mac host $mac_host, user $mac_user"
  echo "  check SSH, install Nix if missing, copy ~/.config/anix, add the amac recipient,"
  echo "  write ~/anix-first-switch/first-switch.command, open Terminal, poll post.ok"
  exit 0
fi

say "Checking the NFS export"
if ! systemctl is-active --quiet nfs-server 2>/dev/null; then
  if [[ ! -e /proc/fs/nfsd ]]; then
    warn "nfs-server is not running and the kernel has not loaded nfsd"
    warn "the 6.6 WSL kernel builds nfsd as a module and WSL loads it only when the VM starts"
    say "from Windows PowerShell"
    echo "  wsl --shutdown"
    echo "  wsl -d ${WSL_DISTRO_NAME:-NixOS}"
    say "then rerun"
    echo "  cd ~/.config/anix && scripts/bootstrap-mac-remote"
    exit 1
  fi
  warn "nfs-server is not running; start it, then rerun"
  echo "  sudo systemctl start nfs-server"
  exit 1
fi

say "Waiting for SSH to $mac_user@$mac_host"
echo "  On the Mac: connect Tailscale, then System Settings > Sharing > Remote Login."
attempt=0
while true; do
  if ssh_error=$("${SSH[@]}" true 2>&1); then
    break
  fi
  attempt=$((attempt + 1))
  [[ -n $ssh_error ]] && echo "  $ssh_error"
  if [[ $assume_yes -eq 1 && $attempt -ge 12 ]]; then
    die "SSH still unavailable; enable Remote Login on the Mac and rerun"
  fi
  if ! ask "SSH is not available yet. Retry?" y; then die "enable Remote Login and rerun"; fi
  sleep 5
done
say "Checking the Mac"
mac_arch=$("${SSH[@]}" 'uname -m') || die "could not read the Mac architecture"
case "$mac_arch" in
  arm64) ;;
  x86_64)
    warn "this Mac is Intel (x86_64). nixpkgs 26.05 is the last release that"
    warn "supports x86_64-darwin, so Nix security updates stop after 2026."
    ;;
  *) die "unsupported Mac architecture: $mac_arch" ;;
esac
say "Mac architecture: $mac_arch"
# Accept the winona-era ordering: authorize the builder key before nix-darwin
# disables password login, otherwise a failed switch locks SSH out.
say "Authorizing the builder key for $mac_user"
"${SSH[@]}" 'set -e; mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"; touch "$HOME/.ssh/authorized_keys"; chmod 600 "$HOME/.ssh/authorized_keys"; key=$(cat); if ! grep -qxF "$key" "$HOME/.ssh/authorized_keys"; then [ -z "$(tail -c 1 "$HOME/.ssh/authorized_keys")" ] || printf "\n" >> "$HOME/.ssh/authorized_keys"; printf "%s\n" "$key" >> "$HOME/.ssh/authorized_keys"; fi' < "$HOME/.ssh/mac-builder.pub"

say "Checking the Command Line Tools on the Mac"
if ! "${SSH[@]}" 'xcode-select -p >/dev/null 2>&1'; then
  echo "  Install the Command Line Tools on the Mac: xcode-select --install"
  if [[ $assume_yes -eq 1 ]]; then
    die "the Command Line Tools are missing on the Mac; run xcode-select --install there, then rerun this script"
  fi
  ask "Continue once the installer is finished?" y || die "CLT is required"
  "${SSH[@]}" 'xcode-select -p >/dev/null 2>&1' ||
    die "the Command Line Tools are still missing on the Mac; run xcode-select --install there"
fi

say "Checking the builder key in the Mac host config"
if ! grep -qF "builderKey = \"$(cat "$HOME/.ssh/mac-builder.pub")\"" "$repo_root/home/default/amac.nix"; then
  die "home/default/amac.nix does not contain the current builder public key; run the anix bootstrap first"
fi

nix_mac=/nix/var/nix/profiles/default/bin/nix
if ! "${SSH[@]}" "test -x $nix_mac"; then
  ask "Install Nix on the Mac now? It asks for the Mac sudo password once." y || die "Nix is required"
  # Download first: a truncated pipe into sh is hard to diagnose, and curl
  # exits before sh has run.
  "${SSH[@]}" 'curl --proto "=https" --tlsv1.2 -sSfL https://nixos.org/nix/install -o "$HOME/anix-nix-install.sh"' ||
    die "could not download the Nix installer on the Mac"
  "${SSH[@]}" -tt 'sh "$HOME/anix-nix-install.sh" --daemon; status=$?; rm -f "$HOME/anix-nix-install.sh"; exit $status'
  "${SSH[@]}" "test -x $nix_mac" || die "Nix was not installed"
fi

if "${SSH[@]}" 'test -e "$HOME/.config/anix/.git"'; then
  if ! ask "Replace the existing ~/.config/anix checkout on the Mac?" y; then
    die "move or remove the Mac checkout and rerun"
  fi
fi
say "Copying the repository to ~/.config/anix"
# Build the new checkout beside the old one, then swap. A failed copy leaves
# the previous checkout in place, and the old one is kept as .bak.<epoch>.
tar -C "$repo_root" -cf - . |
  "${SSH[@]}" 'set -euo pipefail; rm -rf "$HOME/.config/anix.new"; mkdir -p "$HOME/.config/anix.new"; tar -xf - -C "$HOME/.config/anix.new"' ||
  die "could not copy the repository to the Mac"
"${SSH[@]}" 'set -euo pipefail; if [ -e "$HOME/.config/anix" ]; then mv "$HOME/.config/anix" "$HOME/.config/anix.bak.$(date +%Y%m%d%H%M%S)"; fi; mv "$HOME/.config/anix.new" "$HOME/.config/anix"' ||
  die "could not move the new checkout into place on the Mac"

say "Generating the Mac host key"
"${SSH[@]}" -tt 'sudo ssh-keygen -A'
recipient=$("${SSH[@]}" 'cat /etc/ssh/ssh_host_ed25519_key.pub' | ssh_to_age_cmd)
[[ $recipient == age1* ]] || die "could not convert the Mac host key"
if grep -q '^  amac:' "$repo_root/.sops.yaml"; then
  sed -i "s|^  amac: &amac .*|  amac: \&amac $recipient|" "$repo_root/.sops.yaml"
elif grep -q '^  # amac: &amac age1...' "$repo_root/.sops.yaml"; then
  sed -i "s|^  # amac: &amac age1...|  amac: \&amac $recipient|" "$repo_root/.sops.yaml"
else
  sed -i "/^  personal:/a\\  amac: \&amac $recipient" "$repo_root/.sops.yaml"
fi
if ! grep -q '^      - \*amac$' "$repo_root/.sops.yaml"; then
  sed -i '/^      - \*personal$/a\      - *amac' "$repo_root/.sops.yaml"
fi
if [[ $dry_run -eq 0 ]]; then
  SOPS_AGE_KEY_FILE=$HOME/.config/sops/age/keys.txt sops_cmd updatekeys -y secrets/secrets.yaml
  # A missing recipient would only surface inside the Mac activation, after it
  # has already disabled password login.
  grep -qF "$recipient" secrets/secrets.yaml ||
    die "the amac recipient is missing from secrets/secrets.yaml; check .sops.yaml"
  git add .sops.yaml secrets/secrets.yaml
  if ! git diff --cached --quiet -- .sops.yaml secrets/secrets.yaml; then
    if ! git -c user.name=anix-bootstrap -c user.email=anix-bootstrap@localhost \
      commit -m "bootstrap: add the amac sops recipient" -- .sops.yaml secrets/secrets.yaml; then
      warn "the amac recipient commit failed; the working tree still goes to the Mac"
    fi
  fi
  tar -C "$repo_root" -cf - .sops.yaml secrets/secrets.yaml | "${SSH[@]}" 'tar -xf - -C "$HOME/.config/anix"'
fi

if [[ $do_switch -eq 0 ]]; then
  say "Mac host key added; first switch skipped"
  exit 0
fi

say "Writing the first switch command"
"${SSH[@]}" 'mkdir -p "$HOME/anix-first-switch"; rm -f "$HOME/anix-first-switch/post.ok" "$HOME/anix-first-switch/post.fail"'
"${SSH[@]}" 'cat > "$HOME/anix-first-switch/first-switch.command"' <<'EOS'
#!/bin/zsh
set -euo pipefail
export PATH=/nix/var/nix/profiles/default/bin:$PATH
dir="$HOME/anix-first-switch"
mkdir -p "$dir"
rm -f "$dir/post.ok" "$dir/post.fail"
exec > >(tee -a "$dir/first-switch.log") 2>&1
# Keep the Mac awake while the build runs.
if command -v caffeinate >/dev/null 2>&1; then
  caffeinate -dimsu -w $$ &
fi
# The applications step can fail once until App Management is approved. Leave a
# marker so the anix side stops waiting and can say how to retry.
trap 'date > "$dir/post.fail"' ZERR
for f in /etc/nix/nix.conf /etc/nix/nix.custom.conf /etc/bashrc /etc/zshrc; do
  if [ -e "$f" ] && [ ! -e "$f.before-nix-darwin" ]; then
    sudo mv "$f" "$f.before-nix-darwin"
  fi
done
case "$(uname -m)" in
  arm64) flake_attr=amac ;;
  x86_64)
    flake_attr=amac-intel
    echo "warning: this Mac is Intel; nixpkgs 26.05 is the last release that supports x86_64-darwin" >&2
    ;;
  *)
    echo "error: unsupported Mac architecture: $(uname -m)" >&2
    exit 1
    ;;
esac
sudo mkdir -p /etc/nix
sudo env PATH="/nix/var/nix/profiles/default/bin:$PATH" \
  NIX_CONFIG='experimental-features = nix-command flakes' \
  nix run github:LnL7/nix-darwin/nix-darwin-26.05#darwin-rebuild -- \
  switch --flake "$HOME/.config/anix#$flake_attr"
date > "$dir/post.ok"
EOS
"${SSH[@]}" 'chmod +x "$HOME/anix-first-switch/first-switch.command"'

echo "  If Terminal does not open, run on the Mac:"
echo "  /Users/$mac_user/anix-first-switch/first-switch.command"
"${SSH[@]}" "open -a Terminal /Users/$mac_user/anix-first-switch/first-switch.command" 2>/dev/null || \
  warn "could not open Terminal over SSH; run the command above"

say "Waiting for the Mac first switch"
# The first switch builds Herdr from source; 90 minutes is not unusual.
for i in $(seq 1 540); do
  if "${SSH[@]}" 'test -e "$HOME/anix-first-switch/post.ok"' 2>/dev/null; then
    say "Mac first switch finished"
    "${SSH[@]}" 'uname -m; mount | grep " on /Users/" || true; herdr plugin list 2>/dev/null || true'
    if ! sudo ssh-keygen -F "$mac_host" >/dev/null 2>&1; then
      sudo install -d -m 700 /root/.ssh
      "${SSH[@]}" 'cat /etc/ssh/ssh_host_ed25519_key.pub' |
        awk -v h="$mac_host" '{print h, $1, $2}' |
        sudo tee -a /root/.ssh/known_hosts >/dev/null
      say "recorded the Mac host key for the root builder"
    fi
    say "Installing the Herdr plugins"
    "${SSH[@]}" 'cd "$HOME/.config/anix" && ./scripts/install-herdr-plugins.sh' ||
      warn "Herdr plugin install failed; rerun it after the first GUI login"
    exit 0
  fi
  if "${SSH[@]}" 'test -e "$HOME/anix-first-switch/post.fail"' 2>/dev/null; then
    warn "the first switch stopped; read /Users/$mac_user/anix-first-switch/first-switch.log"
    echo "  Approve the App Management prompt, then run on the Mac:"
    echo "  /Users/$mac_user/anix-first-switch/first-switch.command"
    exit 1
  fi
  sleep 10
  if (( i % 60 == 0 )); then
    say "still building after $((i / 6)) minutes; the first switch compiles Herdr from source"
  fi
done
warn "no post.ok yet; inspect /Users/$mac_user/anix-first-switch/first-switch.log"
warn "the switch may still be running; wait for post.ok before rerunning, or two switches will race"
exit 1
