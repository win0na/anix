#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/mount-src

Mount the NFS export from the WSL host at the macOS source directory. Run as
root, or let the script use sudo for the mount.

Environment:
  ANIX_NFS_HOST      NFS server hostname. Defaults to anix, the Windows
                     Tailscale node that forwards to the WSL NFS server.
  ANIX_PROJECTS_DIR  Project root from users.nix. Only the last path
                     component is used for the default mount point.
  ANIX_MOUNT_POINT   Local mount point. Overrides the computed path.

Options:
  -h, --help       Show this help and exit.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

# Under sudo the ANIX_* variables are dropped, so fall back to users.nix in the
# checkout this script lives in.
if [[ -z ${ANIX_PROJECTS_DIR:-} ]]; then
  script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  # shellcheck source=anix-config.sh
  # shellcheck disable=SC1091
  . "$script_dir/anix-config.sh"
  ANIX_PROJECTS_DIR=$(anix_projects_dir "$script_dir/../users.nix")
  anix_user=$(anix_value_from_users anix "$script_dir/../users.nix")
  # A hand-edited users.nix must not mount the export over a system folder.
  anix_check_projects_dir "$ANIX_PROJECTS_DIR" "/home/${anix_user:-$(id -un)}" || {
    echo "error: invalid projectsDir in users.nix: $ANIX_PROJECTS_DIR" >&2
    exit 1
  }
fi

project_name=${ANIX_PROJECTS_DIR:-src}
project_name=${project_name%/}
project_name=${project_name##*/}
[[ -n $project_name ]] || {
  echo "error: empty project root; set projectsDir in users.nix" >&2
  exit 1
}
if [[ -n ${ANIX_MAC_HOME:-} ]]; then
  default_mount="${ANIX_MAC_HOME}/${project_name}"
elif [[ "$(id -u)" -eq 0 ]]; then
  # /dev/console is owned by root before the first GUI login.
  console_user=$(/usr/bin/stat -f%Su /dev/console)
  [[ -n $console_user && $console_user != root ]] || {
    echo "error: no logged-in console user; set ANIX_MOUNT_POINT or ANIX_MAC_HOME" >&2
    exit 1
  }
  default_mount="/Users/${console_user}/${project_name}"
else
  default_mount="$HOME/${project_name}"
fi
MOUNT_POINT=${ANIX_MOUNT_POINT:-$default_mount}
NFS_HOST=${ANIX_NFS_HOST:-anix}

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "error: mount-src runs on macOS, found $(uname -s)" >&2
  exit 1
fi

if mount | awk -v mp="$MOUNT_POINT" '$3 == mp { found = 1 } END { exit !found }'; then
  echo "==> already mounted at $MOUNT_POINT"
  echo "==> host: $NFS_HOST"
  echo "==> mount point: $MOUNT_POINT"
  exit 0
fi

tailscale_bin=""
if command -v tailscale >/dev/null 2>&1; then
  tailscale_bin="$(command -v tailscale)"
elif [[ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]]; then
  tailscale_bin="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
fi

ready=0
deadline=$((SECONDS + 60))
while (( SECONDS < deadline )); do
  if [[ -n "$tailscale_bin" ]]; then
    "$tailscale_bin" status >/dev/null 2>&1 || true
  fi
  if nc -z -G 5 "$NFS_HOST" 2049 >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 2
done

if (( ready == 0 )); then
  echo "error: $NFS_HOST:2049 not reachable after 60 seconds" >&2
  echo "error: check Tailscale on the Mac and the Windows node, then retry" >&2
  exit 1
fi

mkdir -p "$MOUNT_POINT"

options="vers=4.1,resvport,rw,noowners,hard,intr,rsize=131072,wsize=131072,bg"
if [[ "$(id -u)" -ne 0 ]]; then
  echo "==> sudo mount_nfs -o $options $NFS_HOST:/ $MOUNT_POINT"
  sudo mount_nfs -o "$options" "$NFS_HOST:/" "$MOUNT_POINT"
else
  echo "==> mount_nfs -o $options $NFS_HOST:/ $MOUNT_POINT"
  mount_nfs -o "$options" "$NFS_HOST:/" "$MOUNT_POINT"
fi

echo "==> host: $NFS_HOST"
echo "==> mount point: $MOUNT_POINT"
