#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/provision [options]

Run from the old Ubuntu WSL distribution. Installs Nix if it is missing, then
installs a fresh NixOS-WSL distribution alongside Ubuntu, transfers the
selected trees and keys, runs the anix bootstrap inside NixOS, then prepares
the Mac. Ubuntu is not removed until both hosts pass and you confirm at the end.

Options:
  --distro NAME       New WSL distribution name. Default NixOS.
  --anix-user USER    anix login. Default from users.nix.
  --mac-user USER     amac login. Default from users.nix.
  --projects-dir DIR  Project root. Default from users.nix, then src. A
                      relative name stays under the anix home; an absolute
                      path under /home or /mnt is used as-is.
  --mac-host HOST     Mac Tailscale/MagicDNS name. Default amac.
  --dir PATH          Extra directory to transfer. Repeatable.
  --backup PATH       Windows path for the Ubuntu export.
  --image-url URL     NixOS-WSL image. Default the pinned 2605.7.2 asset.
  --image-sha SHA     Image SHA-256.
  --no-transfer       Skip the project checklist; keys and the repository still transfer.
  --no-mac            Stop after the anix bootstrap.
  --no-finalize       Do not offer to unregister Ubuntu.
  --skip-backup       Do not export Ubuntu before installation.
  --dry-run           Print actions without changing the host.
  -y, --yes           Accept defaults; never unregisters Ubuntu.
  -h, --help          Show this help.
EOF
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'warning: %s\n' "$*" >&2; }
say() { printf '\n==> %s\n' "$*"; }
usage_error() { printf 'error: %s\n' "$*" >&2; usage >&2; exit 2; }

original_args=("$@")
assume_yes=0
dry_run=0
distro=NixOS
anix_user=
mac_user=
mac_host=amac
projects_dir_arg=
backup=
image_url=https://github.com/nix-community/NixOS-WSL/releases/download/2605.7.2/nixos.wsl
image_sha=e7180ad555fdcb8e1e057e2ef056de467603a5e502ff8531053738371be3f6b9
selected=()
extra_dirs=()
do_transfer=1
do_mac=1
do_finalize=1
do_backup=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --distro) [[ $# -ge 2 ]] || usage_error "--distro needs a name"; distro=$2; shift 2 ;;
    --distro=*) distro=${1#*=}; shift ;;
    --anix-user) [[ $# -ge 2 ]] || usage_error "--anix-user needs a name"; anix_user=$2; shift 2 ;;
    --anix-user=*) anix_user=${1#*=}; shift ;;
    --mac-user) [[ $# -ge 2 ]] || usage_error "--mac-user needs a name"; mac_user=$2; shift 2 ;;
    --mac-user=*) mac_user=${1#*=}; shift ;;
    --projects-dir) [[ $# -ge 2 ]] || usage_error "--projects-dir needs a path"; projects_dir_arg=$2; shift 2 ;;
    --projects-dir=*) projects_dir_arg=${1#*=}; shift ;;
    --mac-host) [[ $# -ge 2 ]] || usage_error "--mac-host needs a host"; mac_host=$2; shift 2 ;;
    --mac-host=*) mac_host=${1#*=}; shift ;;
    --dir) [[ $# -ge 2 ]] || usage_error "--dir needs a path"; extra_dirs+=("$2"); shift 2 ;;
    --dir=*) extra_dirs+=("${1#*=}"); shift ;;
    --backup) [[ $# -ge 2 ]] || usage_error "--backup needs a Windows path"; backup=$2; shift 2 ;;
    --backup=*) backup=${1#*=}; shift ;;
    --image-url) [[ $# -ge 2 ]] || usage_error "--image-url needs a URL"; image_url=$2; shift 2 ;;
    --image-url=*) image_url=${1#*=}; shift ;;
    --image-sha) [[ $# -ge 2 ]] || usage_error "--image-sha needs a digest"; image_sha=$2; shift 2 ;;
    --image-sha=*) image_sha=${1#*=}; shift ;;
    --no-transfer) do_transfer=0; shift ;;
    --no-mac) do_mac=0; shift ;;
    --no-finalize) do_finalize=0; shift ;;
    --skip-backup) do_backup=0; shift ;;
    --dry-run) dry_run=1; shift ;;
    -y|--yes) assume_yes=1; shift ;;
    *) usage_error "unknown argument: $1" ;;
  esac
done

ask() {
  local prompt=$1 default=${2:-n} reply
  if [[ $assume_yes -eq 1 ]]; then [[ $default == y ]]; return; fi
  if [[ $default == y ]]; then prompt="$prompt [Y/n]"; else prompt="$prompt [y/N]"; fi
  read -r -p "$prompt " reply || true
  reply=${reply:-$default}
  [[ $reply == [Yy]* ]]
}

run() {
  printf '  $'
  printf ' %q' "$@"
  printf '\n'
  [[ $dry_run -eq 1 ]] || "$@"
}

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(git -C "$script_dir/.." rev-parse --show-toplevel 2>/dev/null || true)
[[ -n $repo_root ]] || die "not a git checkout: $script_dir/.."
cd "$repo_root"

# shellcheck source=anix-config.sh
# shellcheck disable=SC1091
. "$script_dir/anix-config.sh"

if ! command -v wsl.exe >/dev/null 2>&1 || ! command -v powershell.exe >/dev/null 2>&1; then
  for p in /mnt/c/Windows/System32 /mnt/c/Windows/System32/WindowsPowerShell/v1.0; do
    [[ -d $p ]] && PATH="$p:$PATH"
  done
  export PATH
fi
command -v wsl.exe >/dev/null || die "wsl.exe not found; run this inside WSL"
command -v powershell.exe >/dev/null || die "powershell.exe not found; run this inside WSL"
[[ -n ${WSL_DISTRO_NAME:-} ]] || die "WSL_DISTRO_NAME is not set; run this from the Ubuntu WSL shell"
if ! command -v nix >/dev/null 2>&1; then
  for p in "$HOME/.nix-profile/bin" /nix/var/nix/profiles/default/bin; do
    [[ -x "$p/nix" ]] && PATH="$p:$PATH"
  done
  export PATH
fi
if ! command -v nix >/dev/null 2>&1; then
  if [[ $dry_run -eq 1 ]]; then
    warn "nix is not installed; the dry run continues without it"
  else
    say "installing Nix"
    "$repo_root/scripts/install" --ensure-nix
    for p in "$HOME/.nix-profile/bin" /nix/var/nix/profiles/default/bin; do
      [[ -x "$p/nix" ]] && PATH="$p:$PATH"
    done
    export PATH
    command -v nix >/dev/null 2>&1 || die "nix is still missing after the install"
  fi
fi
missing_material() {
  if [[ ! -s $HOME/.config/sops/age/keys.txt ]]; then
    printf '%s\n' "$HOME/.config/sops/age/keys.txt"
  elif [[ ! -s $HOME/.ssh/mac-builder ]]; then
    printf '%s\n' "$HOME/.ssh/mac-builder"
  elif [[ ! -s $repo_root/secrets/secrets.yaml ]]; then
    printf '%s\n' "$repo_root/secrets/secrets.yaml"
  fi
}

if missing=$(missing_material) && [[ -n $missing ]]; then
  say "missing $missing"
  if [[ $dry_run -eq 1 ]]; then
    say "would run scripts/bootstrap --prepare"
  else
    say "running scripts/bootstrap --prepare"
    prepare_args=(--prepare)
    [[ $assume_yes -eq 1 ]] && prepare_args+=(--yes)
    "$repo_root/scripts/bootstrap" "${prepare_args[@]}" || die "missing $missing"
    missing=$(missing_material)
    [[ -z $missing ]] || die "missing $missing"
  fi
fi
[[ $repo_root == "$HOME/.config/anix" ]] || warn "running from $repo_root; the repository is staged to $HOME/.config/anix"

sops_cmd() { nix --extra-experimental-features 'nix-command flakes' shell --inputs-from "$repo_root" nixpkgs#sops -c sops "$@"; }
age_cmd() { nix --extra-experimental-features 'nix-command flakes' shell --inputs-from "$repo_root" nixpkgs#age -c age "$@"; }
age_keygen_cmd() { nix --extra-experimental-features 'nix-command flakes' shell --inputs-from "$repo_root" nixpkgs#age -c age-keygen "$@"; }
ssh_to_age_cmd() { nix --extra-experimental-features 'nix-command flakes' shell --inputs-from "$repo_root" nixpkgs#ssh-to-age -c ssh-to-age "$@"; }

export_ubuntu() {
  local dest=${1%.age} unix recipient out
  recipient=$(age_keygen_cmd -y "$HOME/.config/sops/age/keys.txt")
  unix=$(wslpath -u "$dest")
  out="${unix}.age"
  # Write to a partial file so a failed or interrupted rerun cannot destroy an
  # earlier good backup that has the same name.
  if wsl.exe --export "$WSL_DISTRO_NAME" - | age_cmd -r "$recipient" -o "${out}.partial" &&
    [[ -s ${out}.partial ]] && mv -f "${out}.partial" "$out"; then
    backup="${dest}.age"
    say "Ubuntu backup: ${dest}.age"
    return 0
  fi
  rm -f "${out}.partial"
  warn "the age-encrypted export failed"
  if ! ask "Write a plaintext archive instead? It will contain the age key." n; then
    die "backup cancelled; nothing was unregistered"
  fi
  warn "the plaintext archive contains the age key; protect or delete it"
  wsl.exe --export "$WSL_DISTRO_NAME" "$dest" ||
    die "the plaintext export failed; nothing was unregistered"
  backup=$dest
}

if [[ $dry_run -eq 0 ]] && ! SOPS_AGE_KEY_FILE=$HOME/.config/sops/age/keys.txt sops_cmd decrypt "$repo_root/secrets/secrets.yaml" >/dev/null 2>&1; then
  die "cannot decrypt secrets/secrets.yaml with the personal age key"
fi

value_from_users() {
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$repo_root/users.nix" | head -1
}
[[ -n $anix_user ]] || anix_user=$(value_from_users anix)
[[ -n $mac_user ]] || mac_user=$(value_from_users amac)
[[ -n $anix_user ]] || die "could not read users.anix from users.nix"
[[ -n $mac_user ]] || die "could not read users.amac from users.nix"

projects_dir=${projects_dir_arg:-$(value_from_users projectsDir)}
[[ -n $projects_dir ]] || projects_dir=src
projects_dir=${projects_dir%/}
[[ -n $projects_dir ]] || die "project directory is empty"
if [[ -z $projects_dir_arg && $assume_yes -eq 0 && -t 0 ]]; then
  read -r -p "Project directory [$projects_dir]: " reply || true
  projects_dir=${reply:-$projects_dir}
  projects_dir=${projects_dir%/}
fi
[[ $projects_dir =~ ^[A-Za-z0-9._/-]+$ ]] || die "invalid project directory: $projects_dir"
anix_check_projects_dir "$projects_dir" "/home/$anix_user" ||
  die "invalid project directory: $projects_dir"
[[ $projects_dir != *..* ]] || die "project directory must not contain .."
[[ $projects_dir != "/" && $projects_dir != "." && $projects_dir != */ ]] ||
  die "project directory must be a directory name or an absolute path"
case "$projects_dir" in
  /*) projects_path=$projects_dir; projects_rel="" ;;
  *) projects_path="$HOME/$projects_dir"; projects_rel=$projects_dir ;;
esac
current_projects=$(value_from_users projectsDir)

for name in "$anix_user" "$mac_user" "$distro" "$mac_host"; do
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid name or host: $name"
done

if [[ $anix_user != $(value_from_users anix) || $mac_user != $(value_from_users amac) || $projects_dir != "$current_projects" ]]; then
  if ask "Write $anix_user, $mac_user, and $projects_dir to users.nix?" y; then
    if [[ $dry_run -eq 1 ]]; then
      say "would write users.nix with anix=$anix_user amac=$mac_user projectsDir=$projects_dir"
    else
      cat > "$repo_root/users.nix" <<EOF
{
  anix = "$anix_user";
  amac = "$mac_user";
  projectsDir = "$projects_dir";
}
EOF
      run git -C "$repo_root" add users.nix
      run git -C "$repo_root" -c user.name=anix-bootstrap -c user.email=anix-bootstrap@localhost commit -m "bootstrap: set the host usernames and project root" -- users.nix
    fi
  else
    die "users.nix does not match the requested values"
  fi
fi

if [[ $do_finalize -eq 1 && $do_mac -eq 1 && $WSL_DISTRO_NAME == "$distro" ]]; then
  die "refusing to run with finalize against $distro; this is the new host"
fi

say "Plan"
printf '  distro: %s\n  anix user: %s\n  mac user: %s\n  mac host: %s\n  project root: %s\n' "$distro" "$anix_user" "$mac_user" "$mac_host" "$projects_dir"
echo "  windows: writes .wslconfig, opens TCP 2049, imports the image"

if [[ $do_backup -eq 1 ]]; then
  if [[ -z $backup ]]; then
    win_home=$(powershell.exe -NoProfile -Command '$env:USERPROFILE' | tr -d '\r\n')
    [[ -n $win_home ]] || die "could not read the Windows user profile"
    backup="$win_home\\anix-ubuntu-backup.tar"
  fi
  if ask "Export the current Ubuntu distribution to $backup before installing?" y; then
    if [[ $dry_run -eq 1 ]]; then
      say "would export Ubuntu to an age-encrypted archive"
    else
      export_ubuntu "$backup"
    fi
  fi
fi

say "Installing NixOS-WSL alongside $WSL_DISTRO_NAME"
win_temp=$(powershell.exe -NoProfile -Command '$env:TEMP' | tr -d '\r\n')
[[ -n $win_temp ]] || die "could not read the Windows temp directory"
win_temp_unix=$(wslpath -u "$win_temp")
win_stage="$win_temp_unix/anix"
run mkdir -p "$win_stage"
# An elevated process cannot reliably read a \\wsl.localhost path, so run the
# helper and its wrapper from the Windows temp directory.
run cp "$repo_root/scripts/bootstrap-windows.ps1" "$win_stage/bootstrap-windows.ps1"
win_helper=$(wslpath -w "$win_stage/bootstrap-windows.ps1")
win_log="$win_temp\\anix\\anix-bootstrap-windows.log"
stage_cleanup() { rm -f "$win_stage/bootstrap-windows.ps1" "$win_stage/anix-elevate.ps1"; }
trap stage_cleanup EXIT
admin=$(powershell.exe -NoProfile -Command '([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)' | tr -d '\r\n')
helper_args=("-Yes" "-SkipWslUpdate" "-NoShutdown" "-NoFirstSwitch" "-NoClone" "-DistroName" "$distro" "-AnixUser" "$anix_user" "-ProjectsDir" "$projects_dir" "-ImageUrl" "$image_url" "-ImageSha256" "$image_sha")

if [[ $dry_run -eq 1 ]]; then
  printf '  $ powershell.exe -File %q %s\n' "$win_helper" "${helper_args[*]}"
elif [[ $admin == "True" ]]; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$win_helper" "${helper_args[@]}" ||
    die "the Windows helper failed; read $win_log, then rerun scripts/provision"
else
  wrapper="$win_stage/anix-elevate.ps1"
  {
    echo '$ErrorActionPreference = "Stop"'
    printf '$p = Start-Process -FilePath powershell.exe -Verb RunAs -Wait -PassThru -ArgumentList @('
    printf "'-NoProfile','-ExecutionPolicy','Bypass','-File','\"%s\"'" "$(printf '%s' "${win_helper//\'/\'\'}")"
    for arg in "${helper_args[@]}"; do printf ",%s" "$(printf "'%s'" "${arg//\'/\'\'}")"; done
    echo ')'
    echo 'if ($p.ExitCode -ne 0) {'
    echo '  Write-Host "The Windows helper failed with exit code $($p.ExitCode)."'
    printf '%s\n' '  Write-Host "Log: $env:TEMP\anix\anix-bootstrap-windows.log"'
    echo '  Read-Host "Press Enter to close" | Out-Null'
    echo '}'
    echo 'exit $p.ExitCode'
  } > "$wrapper"
  echo "  Approve the Windows UAC prompt to install $distro."
  win_wrapper=$(wslpath -w "$wrapper")
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$win_wrapper" || {
    if [[ ! -s $win_log ]]; then
      die "the Windows helper did not start; approve the UAC prompt, then rerun scripts/provision"
    fi
    die "the Windows helper failed; read $win_log, then rerun scripts/provision"
  }
fi

if [[ $dry_run -eq 0 ]] && ! wsl.exe --list --quiet 2>/dev/null | tr -d '\0\r' | grep -qx "$distro"; then
  if [[ ! -s $win_log ]]; then
    die "the Windows helper did not start; approve the UAC prompt, then rerun scripts/provision"
  fi
  die "the $distro distribution was not created; read $win_log, then rerun scripts/provision"
fi

first_switch=1
if [[ $dry_run -eq 0 ]] && wsl.exe -d "$distro" -u root --exec id "$anix_user" >/dev/null 2>&1; then
  first_switch=0
fi
if [[ $first_switch -eq 0 ]]; then
  say "$distro already has $anix_user; skipping the first switch"
else
  say "Staging the repository for the first switch"
  if [[ $dry_run -eq 0 ]]; then
    tar -C "$repo_root" --exclude=.git -cf - . | wsl.exe -d "$distro" -u nixos --exec bash -lc 'set -euo pipefail; rm -rf /tmp/anix; mkdir -p /tmp/anix; tar -xf - -C /tmp/anix; rm -f /tmp/anix/secrets/secrets.yaml' ||
      die "staging the repository for the first switch failed; rerun scripts/provision"
  else
    echo "  $ tar -C $repo_root --exclude=.git -cf - . | wsl.exe -d $distro -u nixos --exec tar -xf - -C /tmp/anix"
  fi
  say "Running the first anix switch"
  run wsl.exe -d "$distro" -u nixos --exec bash -lc 'set -euo pipefail; export PATH=/nix/var/nix/profiles/default/bin:$PATH; sudo env PATH="$PATH" NIX_CONFIG="experimental-features = nix-command flakes" nixos-rebuild boot --flake /tmp/anix#anix' ||
    die "the first anix switch failed; rerun scripts/provision"
  run wsl.exe --terminate "$distro"
  run wsl.exe -d "$distro" -u "$anix_user" --exec true ||
    die "the new distribution did not start as $anix_user; rerun scripts/provision"
fi

if [[ $do_transfer -eq 1 ]]; then
  if [[ -n $projects_rel ]]; then
    say "Selecting directories to transfer"
    projects_top=${projects_rel%%/*}
    mapfile -t candidates < <(
      {
        find "$HOME" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' |
          grep -vxF -e src -e "$projects_top" | grep -v '^\.' || true
        find "$projects_path" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf "$projects_rel/%f\n" 2>/dev/null |
          grep -v "^$projects_rel/anix$" || true
      } | sort -u
    )
    if [[ ${#candidates[@]} -gt 0 && $assume_yes -eq 0 ]]; then
      printf '  select directories to move into the NixOS home (space separated numbers):\n'
      for i in "${!candidates[@]}"; do printf '  %3d  %s\n' "$((i+1))" "${candidates[$i]}"; done
      read -r -p "  numbers (blank transfers none): " reply || true
      for n in $reply; do
        if [[ $n =~ ^[0-9]+$ ]] && ((n >= 1 && n <= ${#candidates[@]})); then
          selected+=("${candidates[$((n-1))]}")
        fi
      done
    fi
  else
    warn "project root is absolute; existing projects are not transferred"
  fi
fi
for d in "${extra_dirs[@]}"; do
  case "$d" in
    /*) die "--dir must be relative to the anix home: $d" ;;
  esac
  [[ -d $HOME/$d ]] || [[ -L $HOME/$d ]] || die "directory not found under $HOME: $d"
  selected+=("$d")
done
mapfile -t selected < <(printf '%s\n' "${selected[@]}" | awk 'NF && !seen[$0]++')

say "Transferring the repository"
if [[ $dry_run -eq 1 ]]; then
  printf '  $ tar -C %s -cf - . | wsl.exe ... tar -xf - -C %s/.config/anix\n' "$repo_root" "$HOME"
else
  # Stage and swap. An interrupted earlier transfer can leave a partial .git,
  # and treating that as a finished checkout skips every later step.
  tar -C "$repo_root" -cf - . |
    wsl.exe -d "$distro" -u "$anix_user" --exec bash -lc 'set -euo pipefail; stage="$HOME/.config/anix.stage.$$"; trap "rm -rf \"$stage\"" EXIT; rm -rf "$stage"; mkdir -p "$stage" "$HOME/.config"; tar -xf - -C "$stage"; if [ -s "$HOME/.config/anix/.git/HEAD" ]; then rm -rf "$stage"; else rm -rf "$HOME/.config/anix"; mv "$stage" "$HOME/.config/anix"; fi' ||
    die "copying the repository to $distro failed; rerun: scripts/provision ${original_args[*]:-}"
  # The target may already hold recipient commits. Update only users.nix.
  tar -C "$repo_root" -cf - users.nix |
    wsl.exe -d "$distro" -u "$anix_user" --exec bash -lc 'set -euo pipefail; tar -xf - -C "$HOME/.config/anix"' ||
    die "writing users.nix in $distro failed; rerun: scripts/provision ${original_args[*]:-}"
fi

say "Transferring keys and ${#selected[@]} project paths"
if [[ $dry_run -eq 1 ]]; then
  printf '  $ tar -C %s -cf - .config/sops/age/keys.txt .ssh/mac-builder %s | wsl.exe ...\n' "$HOME" "${selected[*]}"
else
  tar -C "$HOME" \
    --exclude='*/target' --exclude='*/node_modules' --exclude='*/DerivedData' \
    --exclude='*/.direnv' --exclude='*/.cache' --exclude='*/__pycache__' \
    --exclude='*/.next' --exclude='*/.venv' --exclude='*/Pods' \
    --exclude='*/xcuserdata' --exclude='*.dSYM' \
    -cf - .config/sops/age/keys.txt .ssh/mac-builder "${selected[@]}" |
    wsl.exe -d "$distro" -u "$anix_user" --exec bash -lc 'set -euo pipefail; tar -xf - --skip-old-files -C "$HOME"; chmod 700 "$HOME/.ssh" "$HOME/.config/sops/age"; chmod 600 "$HOME/.ssh/mac-builder" "$HOME/.config/sops/age/keys.txt" "$HOME/.config/anix/secrets/secrets.yaml" 2>/dev/null || true'
fi

say "Running the anix bootstrap inside $distro"
bootstrap_args=(--host anix)
[[ $assume_yes -eq 1 ]] && bootstrap_args+=(--yes)
bootstrap_cmd='cd "$HOME/.config/anix" && exec ./scripts/bootstrap'
for arg in "${bootstrap_args[@]}"; do
  bootstrap_cmd+=" $(printf '%q' "$arg")"
done
if [[ $dry_run -eq 1 ]]; then
  echo "  $ wsl.exe -d $distro -u $anix_user --exec bash -lc '$bootstrap_cmd'"
else
  wsl.exe -d "$distro" -u "$anix_user" --exec bash -lc "$bootstrap_cmd" ||
    die "the anix bootstrap in $distro failed; fix the reported step, then rerun: scripts/provision ${original_args[*]:-}"
fi

if [[ $do_mac -eq 1 ]]; then
  say "Preparing the Mac"
  mac_args=(--mac-host "$mac_host" --mac-user "$mac_user" --anix-user "$anix_user")
  [[ $assume_yes -eq 1 ]] && mac_args+=(--yes)
  if [[ $dry_run -eq 1 ]]; then
    say "would run scripts/bootstrap-mac-remote inside $distro"
  else
    mac_cmd='cd "$HOME/.config/anix" && exec ./scripts/bootstrap-mac-remote'
    for arg in "${mac_args[@]}"; do
      mac_cmd+=" $(printf '%q' "$arg")"
    done
    wsl.exe -d "$distro" -u "$anix_user" --exec bash -lc "$mac_cmd" ||
      die "the Mac phase failed; rerun it inside $distro with: scripts/bootstrap-mac-remote ${mac_args[*]}"
  fi
fi

if [[ $do_finalize -eq 1 && $do_mac -eq 1 ]]; then
  say "Final check"
  if [[ $WSL_DISTRO_NAME == "$distro" ]]; then
    die "refusing to unregister the distribution this script is running in"
  fi
  if [[ $dry_run -eq 0 ]] && ! grep -q '^  recovery: &recovery ' "$repo_root/.sops.yaml" 2>/dev/null; then
    die "no recovery recipient in .sops.yaml; run scripts/bootstrap --prepare in ~/.config/anix, then rerun this script. Nothing was unregistered."
  fi
  [[ -n $backup ]] || backup=$(powershell.exe -NoProfile -Command '$env:USERPROFILE' | tr -d '\r\n')
  [[ $backup == *.age || $backup == *.tar ]] || backup="$backup\\anix-ubuntu-backup.tar"
  if [[ $dry_run -eq 1 ]]; then
    say "would export $WSL_DISTRO_NAME to an age-encrypted archive"
  else
    backup_unix=$(wslpath -u "$backup")
    if [[ -s $backup_unix ]]; then
      say "Existing backup: $backup"
    elif ask "Export $WSL_DISTRO_NAME before removing it? The archive is the only copy." y; then
      export_ubuntu "$backup"
      backup_unix=$(wslpath -u "$backup")
    fi
    # Unregistering without a backup loses the recovery key and every file
    # that was not selected for transfer.
    if [[ ! -s $backup_unix ]]; then
      die "refusing to unregister $WSL_DISTRO_NAME without a backup; rerun with --backup <windows path>, or remove it yourself with: wsl.exe --unregister $WSL_DISTRO_NAME"
    fi
  fi
  confirm=""
  if [[ $assume_yes -eq 0 ]]; then
    read -r -p "Type $WSL_DISTRO_NAME to unregister it, or press Enter to keep it: " confirm || true
  fi
  if [[ $confirm == "$WSL_DISTRO_NAME" ]]; then
    run wsl.exe --unregister "$WSL_DISTRO_NAME"
  else
    echo "  Keeping $WSL_DISTRO_NAME. Remove it later with: wsl.exe --unregister $WSL_DISTRO_NAME"
  fi
fi

say "Provision complete"
echo "  anix: $distro, user $anix_user"
echo "  amac: $mac_host, user $mac_user"
echo "  Run future rebuilds with: scripts/rebuild"
echo
echo "  Restart the WSL VM once so .wslconfig (mirrored networking) takes effect,"
echo "  otherwise the Mac cannot reach the NFS server:"
echo "    wsl.exe --shutdown"
echo "  Then start $distro again, for example: wsl.exe -d $distro"
echo "  The Mac mount retries until the server answers."
