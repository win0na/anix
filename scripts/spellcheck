#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/spellcheck [PATH...]

Run typos over the repository, or over the given files and directories.
The typos configuration is typos.toml at the repository root.
Requires typos on PATH.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

if ! command -v typos >/dev/null 2>&1; then
  echo "spellcheck: typos not found on PATH" >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  set -- "$repo_root"
fi

cd "$repo_root"
exec typos --force-exclude --config "$repo_root/typos.toml" \
  --exclude "**/patches/**" \
  --exclude "**/opencode-dcp-fix/**" \
  --exclude "**/ttt/plugins/**" \
  --exclude "**/secrets/**" \
  "$@"
