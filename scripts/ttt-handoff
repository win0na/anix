#!/usr/bin/env bash
set -euo pipefail

readonly remote_root=/home/winona/src
readonly remote_host=amac

usage() {
  echo "usage: ttt-handoff vscode <path> [line] [col]" >&2
  exit 2
}

[[ $# -ge 2 ]] || usage

target=$1
file=$2
line=${3:-1}
col=${4:-1}

[[ $target == vscode ]] || usage
[[ $line =~ ^[0-9]+$ ]] || line=1
[[ $col =~ ^[0-9]+$ ]] || col=1

case $file in
  *$'\n'*|*$'\r'*)
    echo "ttt-handoff: invalid path" >&2
    exit 2
    ;;
esac

# -m collapses ".." without requiring the path to exist, so an escape such as
# /home/winona/src/../../etc/passwd is rejected before the existence check.
resolved=$(realpath -m -- "$file")
case $resolved in
  "$remote_root"/*) ;;
  *)
    echo "ttt-handoff: path outside $remote_root" >&2
    exit 2
    ;;
esac

[[ -f $resolved ]] || {
  echo "ttt-handoff: file not found: $resolved" >&2
  exit 1
}

if ! command -v systemctl >/dev/null 2>&1; then
  echo "ttt-handoff: systemctl is not available" >&2
  exit 1
fi
if ! systemctl is-active --quiet code-tunnel; then
  echo "ttt-handoff: code-tunnel is not running; start it with: sudo systemctl start code-tunnel" >&2
  exit 1
fi

if ! command -v ssh >/dev/null 2>&1; then
  echo "ttt-handoff: ssh is not on PATH" >&2
  exit 1
fi

p="$resolved:$line:$col"

status=0
printf '%s\n' "$p" | ssh -o BatchMode=yes -o ConnectTimeout=5 "$remote_host" '
  IFS= read -r p || exit 2
  case $p in
    /home/winona/src/*) ;;
    *) echo "ttt-handoff: path outside /home/winona/src" >&2; exit 3 ;;
  esac
  cli="/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
  if [ ! -x "$cli" ]; then
    echo "ttt-handoff: VS Code is not installed on amac at $cli" >&2
    exit 4
  fi
  exec "$cli" --reuse-window --remote tunnel+anix --folder-uri "vscode-remote://tunnel+anix/home/winona/src" --goto "$p"
' || status=$?

if [[ $status -eq 255 ]]; then
  echo "ttt-handoff: ssh to $remote_host failed; check the host and your key" >&2
  exit "$status"
fi
if [[ $status -ne 0 ]]; then
  exit "$status"
fi
