#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/install [options] [REPO_URL]

One command for a new machine. It installs Nix and the few tools the scripts
need, clones your fork, creates the keys and secrets, and runs the host
install.

From Ubuntu WSL or macOS:

  bash <(curl -fsSL https://raw.githubusercontent.com/win0na/anix/main/scripts/install)

The fork URL is prompted when omitted; --yes requires ANIX_REPO_URL or a
positional fork URL.

Options:
  --ensure-nix       Install Nix if it is missing, then exit. Used by the
                     other scripts.
  --anix-user NAME   Linux login for anix. Defaults to $USER.
  --mac-user NAME    macOS short name for amac. Defaults to amac.
  --yes              Accept defaults. Never unregisters Ubuntu.
  --dry-run          Print the plan without changing anything.
  --no-pull          Do not pull an existing checkout.
  -h, --help         Show this help.

On a fresh Windows machine, use scripts/bootstrap-windows.ps1 instead.
EOF
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'warning: %s\n' "$*" >&2; }
say() { printf '\n==> %s\n' "$*"; }
usage_error() { printf 'error: %s\n' "$*" >&2; usage >&2; exit 2; }

run() {
  printf '  $'
  printf ' %q' "$@"
  printf '\n'
  [[ $dry_run -eq 1 ]] || "$@"
}

find_nix() {
  command -v nix >/dev/null 2>&1 && return 0
  local path
  for path in "$HOME/.nix-profile/bin" /nix/var/nix/profiles/default/bin; do
    if [[ -x "$path/nix" ]]; then
      PATH="$path:$PATH"
      export PATH
      return 0
    fi
  done
  return 1
}

ensure_linux_deps() {
  local packages=()
  command -v git >/dev/null 2>&1 || packages+=(git)
  command -v curl >/dev/null 2>&1 || packages+=(curl)
  command -v xz >/dev/null 2>&1 || packages+=(xz-utils)
  if ((${#packages[@]} == 0)); then return 0; fi
  command -v apt-get >/dev/null 2>&1 || die "install ${packages[*]} and rerun"
  say "installing ${packages[*]}"
  if [[ $dry_run -eq 1 ]]; then
    printf '  $ sudo apt-get install -y %s\n' "${packages[*]}"
    return 0
  fi
  run sudo apt-get update
  run sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}"
}

ensure_macos_deps() {
  if xcode-select -p >/dev/null 2>&1; then
    return 0
  fi
  say "installing the Xcode command line tools"
  if [[ $dry_run -eq 1 ]]; then
    printf '  $ xcode-select --install\n'
    return 0
  fi
  xcode-select --install || true
  printf 'Finish the installer window, then press Enter. '
  read -r _ || true
  xcode-select -p >/dev/null 2>&1 || die "the command line tools are still missing"
}

install_nix() {
  say "installing Nix"
  if [[ $dry_run -eq 1 ]]; then
    if [[ $(uname -s) == Darwin ]]; then
      printf '  $ curl -fsSL https://nixos.org/nix/install | sh -s -- --daemon\n'
    else
      printf '  $ curl -fsSL https://nixos.org/nix/install | sh -s -- --no-daemon\n'
    fi
    return 0
  fi
  local installer flag
  installer="$(mktemp "${TMPDIR:-/tmp}/nix-install.XXXXXX")"
  if [[ $(uname -s) == Darwin ]]; then
    flag=--daemon
  else
    flag=--no-daemon
  fi
  printf '  $ curl -fsSL https://nixos.org/nix/install -o %s\n' "$installer"
  if ! curl --proto "=https" --tlsv1.2 -fsSL https://nixos.org/nix/install -o "$installer"; then
    rm -f "$installer"
    die "could not download the Nix installer"
  fi
  printf '  $ sh %s %s\n' "$installer" "$flag"
  if ! sh "$installer" "$flag"; then
    rm -f "$installer"
    die "the Nix installer failed"
  fi
  rm -f "$installer"
  find_nix || die "Nix is installed but not on PATH; open a new shell and rerun"
  say "Nix: $(command -v nix)"
}

ensure_nix() {
  if find_nix; then
    say "Nix: $(command -v nix)"
    return 0
  fi
  case "$(uname -s)" in
    Darwin) ensure_macos_deps ;;
    Linux) ensure_linux_deps ;;
    *) die "unsupported operating system: $(uname -s)" ;;
  esac
  install_nix
}

repo_url="${ANIX_REPO_URL:-}"
anix_user=""
mac_user=""
assume_yes=0
dry_run=0
ensure_nix_only=0
no_pull=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --ensure-nix) ensure_nix_only=1; shift ;;
    --anix-user) [[ $# -ge 2 ]] || usage_error "--anix-user needs a name"; anix_user=$2; shift 2 ;;
    --anix-user=*) anix_user=${1#*=}; shift ;;
    --mac-user) [[ $# -ge 2 ]] || usage_error "--mac-user needs a name"; mac_user=$2; shift 2 ;;
    --mac-user=*) mac_user=${1#*=}; shift ;;
    -y|--yes) assume_yes=1; shift ;;
    --dry-run) dry_run=1; shift ;;
    --no-pull) no_pull=1; shift ;;
    --)
      shift
      repo_url=${1:-}
      if [[ $# -gt 0 ]]; then shift; fi
      ;;
    -*) usage_error "unknown argument: $1" ;;
    *) repo_url=$1; shift ;;
  esac
done

if [[ $ensure_nix_only -eq 1 ]]; then
  ensure_nix
  exit 0
fi

case "$(uname -s)" in
  Darwin)
    if [[ "$(uname -m)" == x86_64 ]]; then
      warn "this Mac is Intel (x86_64). nixpkgs 26.05 is the last release that"
      warn "supports x86_64-darwin, so Nix security updates stop after 2026."
    fi
    ;;
  Linux)
    if [[ ! -e /etc/NIXOS ]] && ! grep -qi microsoft /proc/version; then
      die "run this on Ubuntu WSL, NixOS, or macOS"
    fi
    ;;
  *) die "unsupported operating system: $(uname -s)" ;;
esac

target="$HOME/.config/anix"

current_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
if [[ $current_root == "$target" && -f $current_root/flake.nix && -x $current_root/scripts/install ]]; then
  repo_root=$current_root
else
  repo_root=""
fi

if [[ -z $repo_url && -z $repo_root ]]; then
  if [[ $assume_yes -eq 1 ]]; then
    die "set ANIX_REPO_URL or pass the fork URL with --yes"
  elif [[ -t 0 ]]; then
    while [[ -z $repo_url ]]; do
      read -r -p "Fork URL (create one at https://github.com/win0na/anix/fork): " repo_url || die "a fork URL is required"
    done
  else
    die "set ANIX_REPO_URL or pass the fork URL"
  fi
fi

if [[ $(uname -s) == Linux ]]; then
  if [[ -z $anix_user ]]; then
    default_user=${USER:-anix}
    if [[ $assume_yes -eq 1 ]]; then
      anix_user=$default_user
    else
      read -r -p "Linux username for anix [$default_user]: " anix_user || true
      anix_user=${anix_user:-$default_user}
    fi
  fi
  if [[ -z $mac_user ]]; then
    if [[ $assume_yes -eq 1 ]]; then
      mac_user=amac
    else
      read -r -p "macOS short name for amac (run whoami on the Mac): " mac_user || true
    fi
  fi
  [[ -n $mac_user ]] || die "a macOS short name is required; run whoami on the Mac"
  for name in "$anix_user" "$mac_user"; do
    [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid username: $name"
  done
fi

if [[ $dry_run -eq 1 ]]; then
  if [[ -n $repo_root ]]; then
    say "would use the checkout at $repo_root"
  else
    say "would clone $repo_url to $target"
  fi
  say "would install Nix if it is missing"
  if [[ $(uname -s) == Darwin ]]; then
    say "would run scripts/bootstrap --host amac"
  elif [[ -e /etc/NIXOS ]]; then
    say "would run scripts/bootstrap --host anix"
  else
    say "would create keys and secrets with scripts/bootstrap --prepare"
    say "would run scripts/provision --anix-user $anix_user --mac-user $mac_user"
  fi
  exit 0
fi

ensure_nix

if [[ -z $repo_root ]]; then
  if [[ -d "$target/.git" ]]; then
    repo_root=$target
    if [[ $no_pull -eq 0 ]]; then
      if [[ -n "$(git -C "$repo_root" status --porcelain)" ]]; then
        warn "local changes in $repo_root; not pulling"
      else
        run git -C "$repo_root" pull --ff-only || warn "pull failed; using the current checkout"
      fi
    fi
  elif [[ -e $target ]]; then
    die "$target exists but is not a git checkout"
  else
    say "cloning $repo_url to $target"
    run git clone "$repo_url" "$target"
    repo_root=$target
  fi
fi

cd "$repo_root"

if [[ ! -e .git ]]; then
  die "not a git checkout: $repo_root"
fi

case "$(uname -s)" in
  Darwin)
    args=(--host amac)
    if [[ $assume_yes -eq 1 ]]; then args+=(--yes); fi
    say "starting the Mac bootstrap"
    exec ./scripts/bootstrap "${args[@]}"
    ;;
  Linux)
    if [[ -e /etc/NIXOS ]]; then
      args=(--host anix)
      if [[ $assume_yes -eq 1 ]]; then args+=(--yes); fi
      say "starting the anix bootstrap"
      exec ./scripts/bootstrap "${args[@]}"
    fi
    [[ -n ${WSL_DISTRO_NAME:-} ]] || die "WSL_DISTRO_NAME is not set; open a new Ubuntu WSL shell and rerun"
    prepare_args=(--prepare)
    if [[ $assume_yes -eq 1 ]]; then prepare_args+=(--yes); fi
    say "creating keys and secrets"
    ./scripts/bootstrap "${prepare_args[@]}"
    provision_args=(--anix-user "$anix_user" --mac-user "$mac_user")
    if [[ $assume_yes -eq 1 ]]; then provision_args+=(--yes); fi
    say "starting the host install"
    exec ./scripts/provision "${provision_args[@]}"
    ;;
esac
