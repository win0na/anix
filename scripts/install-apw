#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/install-apw [options]

Build apw with cargo and install the executable to ~/.local/bin. Linux only.
OpenTUI is linked statically, so the installed binary needs no separate library.

Options:
  --path DIR  Install from a local checkout instead of GitHub; the OpenTUI
              build writes its native artifacts into that checkout.
  --force     Rebuild and replace an existing install.
  -h, --help  Show this help and exit.

The remote fetch uses git on PATH. The build uses the flake's nixpkgs for cargo,
rustc, Zig 0.17, pkg-config, dbus, and gcc, so it needs no Rust toolchain on
PATH. The source and build caches live under ~/.cache/anix/apw; later builds
reuse them. The installed binary needs glibc, libdbus-1, libgcc_s, and
libsystemd at runtime.
EOF
}

usage_error() {
  printf 'error: %s\n' "$*" >&2
  usage >&2
  exit 2
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

src_path=""
force=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --path)
      [[ $# -ge 2 && -n $2 ]] || usage_error "--path requires a directory"
      src_path=$2
      shift 2
      ;;
    --path=*)
      src_path=${1#*=}
      [[ -n $src_path ]] || usage_error "--path requires a directory"
      shift
      ;;
    --force)
      force=1
      shift
      ;;
    *)
      usage_error "unknown argument: $1"
      ;;
  esac
done

[[ "$(uname -s)" == Linux ]] || die "apw runs on Linux only"

case "$(uname -m)" in
  x86_64 | amd64) target_triple=x86_64-unknown-linux-gnu ;;
  aarch64 | arm64) target_triple=aarch64-unknown-linux-gnu ;;
  *) die "unsupported architecture: $(uname -m)" ;;
esac

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(git -C "$script_dir/.." rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z $repo_root ]]; then
  repo_root="$(cd "$script_dir/.." && pwd)"
fi

if ! command -v nix >/dev/null 2>&1; then
  if [[ -x "$HOME/.nix-profile/bin/nix" ]]; then
    PATH="$HOME/.nix-profile/bin:$PATH"
    export PATH
  elif [[ -x /nix/var/nix/profiles/default/bin/nix ]]; then
    PATH="/nix/var/nix/profiles/default/bin:$PATH"
    export PATH
  fi
fi
command -v nix >/dev/null 2>&1 || die "nix not found; run scripts/install --ensure-nix first"

cache_root=${XDG_CACHE_HOME:-$HOME/.cache}/anix/apw
target=$HOME/.local/bin/apw
stamp=$HOME/.local/lib/apw/rev

if [[ -n $src_path ]]; then
  [[ -d $src_path ]] || die "not a directory: $src_path"
  checkout="$(cd "$src_path" && pwd)"
  source_desc="checkout $checkout"
  want="$(git -C "$checkout" rev-parse HEAD 2>/dev/null || printf 'path:%s' "$checkout")"
  if git -C "$checkout" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    want="$want:$(git -C "$checkout" diff --no-ext-diff --ignore-submodules=all HEAD -- . |
      sha256sum | cut -d' ' -f1)"
  fi
else
  command -v git >/dev/null 2>&1 || die "git not found"
  apw_rev=8b6a206f8e128af616b64bc1c14a955a03307eb0
  source_desc="github:win0na/apw@${apw_rev:0:7}"
  checkout=$cache_root/src
  want="$apw_rev:$(printf '' | sha256sum | cut -d' ' -f1)"
fi

if [[ -x $target && -f $stamp && $force -eq 0 ]]; then
  installed_want=""
  installed_hash=""
  { IFS= read -r installed_want; IFS= read -r installed_hash; } <"$stamp"
  current_hash=$(sha256sum "$target" | cut -d' ' -f1)
  if [[ $installed_want == "$want" && $installed_hash == "$current_hash" ]]; then
    if "$target" --version; then
      printf 'apw: already installed at %s; use --force to rebuild\n' "$target"
      exit 0
    fi
    printf 'apw: existing install cannot run; rebuilding\n' >&2
  fi
fi

if [[ -z $src_path ]]; then
  mkdir -p "$cache_root"
  if [[ ! -d $checkout/.git ]]; then
    rm -rf "$checkout"
    git init -q "$checkout"
    git -C "$checkout" remote add origin https://github.com/win0na/apw
  else
    git -C "$checkout" remote set-url origin https://github.com/win0na/apw
  fi
  git -C "$checkout" fetch -q --depth 1 origin "$apw_rev"
  git -C "$checkout" reset -q --hard FETCH_HEAD
  git -C "$checkout" submodule update --init --recursive --depth 1
fi

[[ -f $checkout/opentui/packages/native/build.zig ]] ||
  die "the OpenTUI submodule is missing in $checkout; run git submodule update --init --recursive"

mkdir -p "$cache_root/target" "$cache_root/zig-global" "$cache_root/zig-local"
export CARGO_TARGET_DIR="$cache_root/target"
export ZIG_GLOBAL_CACHE_DIR="$cache_root/zig-global"
export ZIG_LOCAL_CACHE_DIR="$cache_root/zig-local"

nix_flags=(--extra-experimental-features "nix-command flakes")
printf '==> building apw from %s\n' "$source_desc"
dbus_dev=$(nix "${nix_flags[@]}" build --no-link --print-out-paths \
  --inputs-from "$repo_root" nixpkgs#dbus.dev)
export PKG_CONFIG_PATH="$dbus_dev/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

(
  cd "$checkout"
  nix "${nix_flags[@]}" shell --inputs-from "$repo_root" \
    nixpkgs#cargo nixpkgs#rustc nixpkgs#zig_0_17 \
    nixpkgs#pkg-config nixpkgs#dbus nixpkgs#git nixpkgs#gcc \
    -c cargo build --release --locked --target "$target_triple"
)

binary=$CARGO_TARGET_DIR/$target_triple/release/apw
[[ -x $binary ]] || die "cargo finished but $binary is missing"

install -Dm755 "$binary" "$target"
"$target" --version
# OpenTUI is static now; remove the library from an older install.
rm -f "$HOME/.local/lib/apw/libopentui.so"

# The cargo build links glibc, dbus, and libgcc from the nix shell, not from a
# profile. Root those store paths or `nix-collect-garbage` removes them and the
# installed binary cannot start.
root_runtime_deps() {
  local root_base=$HOME/.local/lib/apw/deps
  local nix_bin nix_dir nix_store gen dep i=0 failures=0
  local -a deps=()

  while IFS= read -r dep; do
    deps+=("$dep")
  done < <(ldd "$target" 2>/dev/null |
    awk '/=> \/nix\/store/ {print $3} /^[[:space:]]*\/nix\/store/ {print $1}' |
    sed -E 's|^(/nix/store/[^/]+).*|\1|' |
    sort -u)

  if ((${#deps[@]} == 0)); then
    printf 'apw: no Nix store runtime paths to root\n' >&2
    return 0
  fi

  nix_store=$(command -v nix-store 2>/dev/null || true)
  if [[ -z $nix_store ]]; then
    nix_bin=$(command -v nix 2>/dev/null || true)
    nix_dir=${nix_bin%/*}
    if [[ -n $nix_bin && -x $nix_dir/nix-store ]]; then
      nix_store=$nix_dir/nix-store
    fi
  fi
  if [[ -z $nix_store ]]; then
    printf 'apw: nix-store not found; runtime libraries are not GC-rooted\n' >&2
    return 1
  fi

  gen=$root_base/$(date +%s).$$
  mkdir -p "$gen" || return 1
  for dep in "${deps[@]}"; do
    i=$((i + 1))
    "$nix_store" --add-root "$gen/$i" --indirect -r "$dep" >/dev/null 2>&1 || {
      printf 'apw: could not root %s\n' "$dep" >&2
      failures=1
    }
  done
  if ((failures)); then
    printf 'apw: runtime roots are incomplete under %s\n' "$gen" >&2
    rm -rf "$gen"
    return 1
  fi

  # Keep the new generation and drop older roots.
  find "$root_base" -mindepth 1 -maxdepth 1 ! -path "$gen" -exec rm -rf {} + || true
  printf 'apw: rooted %d runtime store path(s) under %s\n' "$i" "$gen"
}

if ! root_runtime_deps; then
  die "apw is installed but its runtime libraries are not GC-rooted; rerun scripts/install-apw"
fi
mkdir -p "$(dirname "$stamp")"
{
  printf '%s\n' "$want"
  sha256sum "$target" | cut -d' ' -f1
} >"$stamp"
chmod 644 "$stamp"
printf 'apw: installed at %s\n' "$target"
