{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "dark"
  },
  "plugins": [
    "oh-my-opencode-slim",
    "./herdr-opencode",
    "./oc-title-strip"
  ],
  "session": {
    "scrollbar": true,
    "markdown": "rendered",
    "thinking": "show",
    "verbosity": "low",
    "sidebar": "auto",
    "grouping": "auto",
    "image_preview": true,
    "tps": true,
    "new_location": "launch",
    "permissions": "autoaccept"
  },
  "animations": true,
  "tabs": {
    "mode": "auto",
    "layout": "horizontal"
  }
}
