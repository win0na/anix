# Copy to .sops.yaml with `scripts/bootstrap --prepare`.
# The host and recovery recipients are filled by scripts/bootstrap.
keys:
  # anix: &anix age1...
  # amac: &amac age1...
  personal: &personal age1...
  # recovery: &recovery age1...

creation_rules:
  - path_regex: ^secrets/[^/]+\.yaml$
    age:
      - *personal
