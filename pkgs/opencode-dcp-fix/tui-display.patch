diff --git a/packages/tui/src/util/message-filter.ts b/packages/tui/src/util/message-filter.ts
new file mode 100644
index 0000000000..689becdb62
--- /dev/null
+++ b/packages/tui/src/util/message-filter.ts
@@ -0,0 +1,23 @@
+/**
+ * Strip context-management metadata from user-visible text.
+ *
+ * DCP and the runtime mark up the transcript they send to the model with
+ * sentinels that only the agent should read. Messages are stored with them
+ * intact, so anything rendering stored text has to filter first.
+ */
+
+const TAGS = ["dcp-system-reminder", "system-reminder"]
+
+/** A DCP reference token, e.g. `@12@` or `@b3@`. */
+const REF = /@b?\d+@/g
+
+export function filterSystemMetadata(text: string): string {
+  let out = text
+  for (const tag of TAGS) {
+    // Unterminated blocks are left alone: a lone tag is more likely prose.
+    out = out.replace(new RegExp(`<${tag}>[\\s\\S]*?</${tag}>`, "g"), "")
+  }
+  out = out.replace(REF, "")
+  out = out.replace(/[ \t]+$/gm, "")
+  return out.replace(/\n{3,}/g, "\n\n").trim()
+}
