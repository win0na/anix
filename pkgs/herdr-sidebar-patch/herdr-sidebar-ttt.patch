+const TTT_WORKSPACE_TOKEN: &str = "hs-ttt-workspace";
+const TTT_TMPDIR_TOKEN: &str = "hs-ttt-tmpdir";
+
+struct TttPane {
+    tab_id: String,
+    pane_id: String,
+    tmpdir: PathBuf,
+}
+
+fn ttt_pane_for(panes_json: &str, workspace_id: &str) -> Option<TttPane> {
+    #[derive(serde::Deserialize)]
+    struct Msg {
+        result: Res,
+    }
+    #[derive(serde::Deserialize)]
+    struct Res {
+        #[serde(default)]
+        panes: Vec<Pane>,
+    }
+    #[derive(serde::Deserialize)]
+    struct Pane {
+        pane_id: Option<String>,
+        tab_id: Option<String>,
+        workspace_id: Option<String>,
+        #[serde(default)]
+        tokens: std::collections::BTreeMap<String, serde_json::Value>,
+    }
+
+    let msg = serde_json::from_str::<Msg>(crate::launch::strip_bom(panes_json)).ok()?;
+    msg.result.panes.into_iter().find_map(|pane| {
+        if pane.workspace_id.as_deref() != Some(workspace_id)
+            || pane.tokens.get(TTT_WORKSPACE_TOKEN)?.as_str()? != workspace_id
+        {
+            return None;
+        }
+        let tmpdir = pane.tokens.get(TTT_TMPDIR_TOKEN)?.as_str()?;
+        Some(TttPane {
+            tab_id: pane.tab_id?,
+            pane_id: pane.pane_id?,
+            tmpdir: PathBuf::from(tmpdir),
+        })
+    })
+}
+
+fn spawn_ttt_file(file: &Path, tmpdir: &Path) -> io::Result<()> {
+    std::process::Command::new("ttt")
+        .arg(file)
+        .env("TMPDIR", tmpdir)
+        .env_remove("TTT_FORWARD_SOCKET")
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .spawn()
+        .map(|_| ())
+}
