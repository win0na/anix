+/// Hand a file to the `ttt-handoff` helper, which validates the absolute path
+/// and the target (`code-server`, `mac`) and launches the app detached from the
+/// sidebar. No shell and no wait: the child gets null stdio and is reaped on a
+/// helper thread so the menu stays responsive.
+pub fn open_handoff(target: &str, path: &Path) -> io::Result<()> {
+    let mut child = std::process::Command::new("ttt-handoff")
+        .arg(target)
+        .arg(path)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .spawn()?;
+    std::thread::spawn(move || {
+        let _ = child.wait();
+    });
+    Ok(())
+}
